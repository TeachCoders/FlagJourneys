# ── Server ──
PORT=5000
NODE_ENV=development

# ── Database ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Email (Gmail) ──
# Use a Gmail App Password (Google Account → Security → App passwords), NEVER your Gmail password
# (Default sender = Gmail. For branded "From" on any SMTP service set SMTP_HOST/SMTP_PORT below)
EMAIL_ID=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
# ── Email SMTP (optional — branded sending, e.g. Brevo smtp-relay.brevo.com:587) ──
# Leave SMTP_HOST empty to keep using Gmail SMTP.
# Branded send (Brevo): EMAIL_ID=leads@flagjourneys.com + EMAIL_PASSWORD=<brevo-smtp-key>
#   SMTP_USER=<brevo-smtp-login> (barabar e.g. xxx@smtp-brevo.com, EMAIL_ID se alag hota hai)
#   SMTP_HOST=smtp-relay.brevo.com / SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# ── Gmail automatic fallback (optional) ──
# Jab SMTP_HOST relay fail/DOWN ho to email automatically Gmail se chale jaata hai
# (From = GMAIL_FALLBACK_USER; brand name same rahega). Empty chhodo agar fallback nahi chahiye.
GMAIL_FALLBACK_USER=
GMAIL_FALLBACK_PASSWORD=

# ── Brand ──
BRAND_NAME=Flag Journeys
SITE_URL=https://flagjourneys.com
BOOKING_PORTAL_URL=https://booking.flagjourneys.com

# ── Company Bank Account (shown in customer payment emails / invoice) ──
# This is the ONLY account customers are told to pay into. Never use a personal account.
BANK_ACCOUNT_HOLDER=INEJ TRAVEL PRIVATE LIMITED
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_TYPE=Current (Business)
BANK_NAME=YES BANK LTD.
BANK_BRANCH_ADDRESS=
BANK_IFSC=YESB0000608
BANK_SWIFT=YESBINBB

# Public base URL of THIS API — used to build image/file URLs stored in the DB.
# Must be the real public URL in production, otherwise stored media links break.
BASE_URL=http://localhost:5000

# ── Supabase Storage (images to Cloud — ₹0 free tier) ──
# OPTIONAL for local dev. Set these to push public media (content, banners,
# galleries) to Supabase Storage instead of the VPS disk. Private folders
# (documents/, user/) ALWAYS stay on the VPS disk + backup for security.
# - SUPABASE_URL:     Project Settings → API → Project URL
# - SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role (secret!)
# Set STORAGE_BACKEND=supabase to enable (leave empty to keep disk uploads).
STORAGE_BACKEND=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Security ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-long-random-string
CSRF_SECRET=replace-with-long-random-string
SEED_ADMIN_EMAIL=superadmin@flagjourneys.com
SEED_ADMIN_PASSWORD=replace-with-strong-password

# Allowed CORS origin(s) for the Next.js frontend. For multiple origins use an array,
# e.g. ["https://flagjourneys.com","https://booking.flagjourneys.com"]
CORS_ORIGIN=http://localhost:3000

# ── Monitoring ──
# Sentry error tracking (optional). Get a free DSN from https://sentry.io — leave
# empty to disable. Backend logs errors to logs/ either way.
SENTRY_DSN=

# ── Lead auto-assignment (Partner) — optional ──
# Email of the user (role: sales) who should automatically receive every new public
# lead. Leave empty to disable auto-assign (leads stay unassigned + UNASSIGNED_LEAD
# notification fires as before).
DEFAULT_ASSIGNEE_EMAIL=

# ── Webhook (Make.com / Zapier / WhatsApp) — optional ──
WEBHOOK_URL=

# ── Internal contacts (used in email templates / notifications) ──
OWNER_EMAIL=
OWNER_MOBILE="+91 00000 00000"
SALES_MOBILE="+91 00000 00000"

# ── Website chat system (₹0) ──
# Telegram alert bot — optional. Create via @BotFather → paste the token.
# TELEGRAM_CHAT_IDS = comma-separated chat/user IDs that should receive alerts.
# Leave both empty to disable (everything still works, just no instant alerts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Personal WhatsApp number shown to tourists for "Continue on WhatsApp" handoff.
# Must be international format WITHOUT "+" (e.g. 919876543210).
CHAT_PARTNER_NUMBER=

# ── Deploy notes ──
# - Keep frontend (flagjourneys.com) and API (api.flagjourneys.com) on the SAME
#   registrable domain so SameSite=Lax session cookies flow to <img>/<a> tags.
# - Set NODE_ENV=production behind a reverse proxy (nginx) so cookies are Secure
#   and `trust proxy` applies.
# - After first deploy run: npx prisma migrate deploy
