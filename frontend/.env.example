# Public base URL of the backend API (Express server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Backend URL for server-side API calls (used by fetchPublic, fetchPublicJson)
API_BASE_URL=http://localhost:5000

# Public base URL of THIS site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand
NEXT_PUBLIC_BRAND_NAME=Flag Journeys

# Analytics
NEXT_PUBLIC_GTM_ID=GTM-MHMD6R9X
NEXT_PUBLIC_GA_ID=G-BJQ7L9MPX3

# Contact (WhatsApp link / phone display)
NEXT_PUBLIC_WHATSAPP_NUMBER=919136739178
# Call/display telephone number (legacy, matches site footer).
NEXT_PUBLIC_SALES_PHONE=+918447273005

# Chat widget "Continue on WhatsApp" handoff number (partner's personal number, no "+").
# Optional — falls back to NEXT_PUBLIC_WHATSAPP_NUMBER when empty.
NEXT_PUBLIC_CHAT_PARTNER_NUMBER=

# ── Monitoring ──
# Sentry error tracking (optional). Get a free DSN from https://sentry.io — leave
# empty to disable. Frontend errors are captured only when this is set at build time.
NEXT_PUBLIC_SENTRY_DSN=

# ── Deploy notes ──
# Values are baked in at BUILD time (next build). On production set these to
# https://api.flagjourneys.com and https://flagjourneys.com before building.
